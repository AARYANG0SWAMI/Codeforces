import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int min = 101, max = -1;
        int minPos = 0, maxPos = 0;

        for (int i = 0; i < n; i++) {
            int x = sc.nextInt();

            if (x > max) {
                max = x;
                maxPos = i;
            }

            if (x <= min) {
                min = x;
                minPos = i;
            }
        }

        int swaps = maxPos + (n - 1 - minPos);

        // If maximum is before minimum, moving max first shifts min left by 1
        if (maxPos > minPos) {
            swaps--;
        }

        System.out.println(swaps);
    }
}
